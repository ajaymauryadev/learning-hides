# Application kis mode mein chalegi; yeh secret nahi hai.
NODE_ENV=development

# Local HTTP server kis port par listen karega; yeh secret nahi hai.
PORT=3000

# Developer apni private MongoDB connection string local .env mein fill karega.
MONGODB_URI=

# Developer ek strong private JWT signing value local .env mein fill karega.
JWT_SECRET=

# Email provider ka private credential local .env ya secret manager mein fill hoga.
EMAIL_API_KEY=
